# ── NSP Registry configuration ───────────────────────────────────────────────
# Copy to .env in this directory (fintech/NSP/.env) and edit. server/config.js
# loads it automatically at startup, so `npm start`, `npm run seed` and the
# scripts pick it up without any extra flags, from any working directory.
#
# Variables already set in the environment take precedence over this file. On
# the VPS systemd injects /opt/nsp/.env via EnvironmentFile before node starts,
# so deployed configuration is never overridden by it.
PORT=4100
HOST=0.0.0.0
# Public base URL printed inside QR codes on cards/certificates (must be reachable by verifiers)
NSP_PUBLIC_URL=https://nsp.ppmc.pk

# SQLite file (default: ./data/nsp-registry.db). Swap server/lib/store.js for Postgres using server/db/schema.sql
NSP_DB_FILE=./data/nsp-registry.db

# Issuing registry identity
NSP_ISSUER_COUNTRY=PK
NSP_ISSUER_NAME=National Skill Passport Registry
NSP_ISSUER_SHORT=NSP Registry
NSP_ISSUER_AUTHORITY=Power Planning & Monitoring Company (PPMC) — TalentLedger
NSP_ISSUER_DID=did:web:nsp.ppmc.pk
NSP_REGISTRAR_TITLE=Registrar, National Skill Passport

# Card / passport validity in years
NSP_CARD_VALIDITY_YEARS=5

# Registry officer API keys: name:key[,name:key...]  (send as X-Registry-Key header)
NSP_REGISTRY_KEYS=registrar:CHANGE-ME-long-random-string,printer:CHANGE-ME-too

# Ed25519 signing key (PKCS#8 PEM). If unset, one is generated into data/signing-key.pem
# NSP_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Allowed browser origins for the API ("*" for any)
NSP_CORS_ORIGINS=*
# Public endpoint rate limit (requests / minute / IP)
NSP_RATE_LIMIT=60

# ── Registration gate ────────────────────────────────────────────────────────
# Five controls stand between the public form and a registry record:
#   1. mobile OTP before the form is accepted   4. four-eyes on issuance
#   2. proof of work + honeypot + velocity caps 5. a full audit trail (always on)
#   3. fuzzy duplicate detection (flags, never blocks)

# Signs OTP code hashes, mobile-verification tokens and proof-of-work
# challenges. MUST be set before running more than one instance, or tokens
# issued by one process will be rejected by another.
#   openssl rand -hex 32
NSP_GATE_SECRET=CHANGE-ME-32-random-bytes-hex

# Master switch. 0 leaves registration wide open — local development only.
NSP_GATE_ENABLED=1
# The officer who verifies a record may not also issue it. Set to 0 only for a
# genuinely single-registrar deployment, as a deliberate, recorded choice.
NSP_FOUR_EYES=1

# 1 ── mobile OTP -------------------------------------------------------------
NSP_OTP_TTL_MIN=10             # how long a code stays valid
NSP_OTP_TOKEN_TTL_MIN=30       # how long the verified-mobile token lets the form stay open
NSP_OTP_MAX_ATTEMPTS=5         # wrong guesses before the code is burned
NSP_OTP_RESEND_COOLDOWN_SEC=60
NSP_OTP_PER_PHONE_HOUR=3

# Returns the OTP in the API response so the flow can be driven without SMS.
# It is IGNORED once a live provider is configured (the service says so at
# startup), so it cannot be left on by accident. Development only.
# NSP_OTP_DEV_ECHO=1

# ── SMS gateway ──────────────────────────────────────────────────────────────
# provider: log | twilio | http | webhook
#   log      writes the code to the journal. Development, or a supervised desk.
#   twilio   international; A2P into Pakistan is restricted and priced per message.
#   http     the declarative driver for local aggregators — see the shapes below.
#   webhook  POSTs {"to","message"} as JSON to something you already run.
NSP_SMS_PROVIDER=log
# Tried only after the primary has exhausted its attempts. Leave empty for none.
# NSP_SMS_FALLBACK_PROVIDER=twilio

# Sender mask / brand name. In Pakistan this must be registered with the
# aggregator and approved by the PTA before it will deliver; an unregistered
# mask is the usual reason a message is accepted and then silently dropped.
NSP_SMS_SENDER=NSP-PK

# Gateways disagree about "+": e164 = +923001234567, plain = 923001234567,
# local = 03001234567. Wrong format is the second most common delivery failure.
NSP_SMS_NUMBER_FORMAT=e164

# {code} and {minutes} are substituted. Keep it inside 160 GSM-7 characters or
# the carrier bills it as two messages. Leave empty for the built-in wording.
# NSP_SMS_TEMPLATE={code} is your National Skill Passport verification code. It expires in {minutes} minutes. Do not share it with anyone.

NSP_SMS_ATTEMPTS=3             # per provider, before failover
NSP_SMS_TIMEOUT_MS=15000
NSP_SMS_RETRY_DELAY_MS=750     # multiplied by the attempt number

# ── http driver ──────────────────────────────────────────────────────────────
# {to}, {message} and {sender} are substituted; the URL is percent-encoded.
# NSP_SMS_SUCCESS_PATTERN matters: most Pakistani gateways answer HTTP 200 with
# a status word in the body, so a 200 alone does not mean the message was sent.
# Check your own account's API documentation for exact parameter names.
#
#   Veevo Tech (v3, GET):
#     NSP_SMS_URL=https://api.veevotech.com/v3/sendsms?hash=YOURHASH&receivenum={to}&sendernum={sender}&textmessage={message}
#     NSP_SMS_NUMBER_FORMAT=plain
#     NSP_SMS_SUCCESS_PATTERN=SUCCESS
#
#   Typical operator / reseller gateway (GET with id + password):
#     NSP_SMS_URL=https://gateway.example.pk/api/sendsms.php?username=ACCT&password=SECRET&mobile={to}&sender={sender}&message={message}
#     NSP_SMS_NUMBER_FORMAT=local
#     NSP_SMS_SUCCESS_PATTERN=^(OK|1701|Message Sent)
#
#   JSON POST with a bearer key:
#     NSP_SMS_URL=https://api.example.pk/v1/messages
#     NSP_SMS_METHOD=POST
#     NSP_SMS_CONTENT_TYPE=application/json
#     NSP_SMS_BODY={"to":"{to}","from":"{sender}","text":"{message}"}
#     NSP_SMS_HEADERS={"Authorization":"Bearer YOUR-KEY"}
#     NSP_SMS_SUCCESS_PATTERN="status"\s*:\s*"(queued|sent|accepted)"
#
# NSP_SMS_URL=
# NSP_SMS_METHOD=GET
# NSP_SMS_BODY=
# NSP_SMS_CONTENT_TYPE=
# NSP_SMS_HEADERS=
# NSP_SMS_SUCCESS_PATTERN=

# ── twilio driver ────────────────────────────────────────────────────────────
# NSP_SMS_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NSP_SMS_TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NSP_SMS_SENDER=+15551234567

# ── webhook driver ───────────────────────────────────────────────────────────
# NSP_SMS_WEBHOOK_URL=https://sms.example.pk/send
# NSP_SMS_WEBHOOK_AUTH=Bearer xxxxx

# 2 ── anti-automation and velocity -------------------------------------------
# Leading zero bits the browser must find; each step up doubles the cost.
# 16 is ~1s on a laptop and a few seconds on a low-end Android handset, while
# still costing a scripted bulk submitter 65,536 hashes per application. Raise
# it only if you are seeing scripted abuse get through the velocity caps.
NSP_POW_DIFFICULTY=16
NSP_POW_TTL_MIN=15
# Caps are generous per shared assessment-centre IP and tight per phone, since
# a phone is the scarcer resource for anyone manufacturing ghost registrations.
NSP_MAX_REG_PER_IP_HOUR=10
NSP_MAX_REG_PER_PHONE_DAY=3
NSP_MAX_REG_PER_DISTRICT_HOUR=200

# 3 ── duplicate detection ----------------------------------------------------
# Score (0-100) at or above which a possible duplicate is flagged for registrar
# review. Flagging never refuses a registration: genuine namesakes sharing a
# date of birth exist, and refusing them would exclude real applicants.
NSP_DEDUP_THRESHOLD=50
