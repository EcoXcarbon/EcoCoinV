# ── NSP Learning (LMS) ───────────────────────────────────────────────────────
# Copy to .env beside docker-compose.yml. These are the compose-level values;
# the application's own settings live in server/.env (see server/.env.example).

MONGO_ROOT_USER=nsp_lms
MONGO_ROOT_PASSWORD=CHANGE-ME-long-random
REDIS_PASSWORD=CHANGE-ME-long-random

# Public base of the tool. It is mounted under the registry's hostname, so the
# path matters: the React router, the service worker scope and every API call
# are all built against /lms.
CLIENT_URL=https://nsp.ppmc.pk/lms
