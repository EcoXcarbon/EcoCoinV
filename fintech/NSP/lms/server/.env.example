# ── NSP Learning — application settings ──────────────────────────────────────
# Copy to server/.env. MONGODB_URI, REDIS_URL, PORT, NODE_ENV and CLIENT_URL are
# supplied by docker-compose; everything below is the application's own.
#
# The three secrets are REQUIRED and the server refuses to start in production
# without them. They are this tool's alone — do not reuse TalentLedger's, or a
# token minted by one system would be accepted by the other.
#   JWT_SECRET / JWT_REFRESH_SECRET : openssl rand -hex 32   (min 32 chars)
#   ENCRYPTION_KEY                  : openssl rand -hex 32   (exactly 64 hex)
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=

# ── Email (learner invitations, password resets, result notices) ─────────────
SMTP_HOST=64.31.47.106
SMTP_PORT=465
SMTP_USER=support@ppmc.pk
SMTP_PASS=
EMAIL_FROM=NSP Learning <support@ppmc.pk>

# ── Optional integrations. Each degrades gracefully when unset. ──────────────
# Google sign-in. Callback must be <CLIENT_URL>/api/auth/google/callback and be
# registered in the Google console, or sign-in fails with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://nsp.ppmc.pk/lms/api/auth/google/callback

# AI marking and question generation. 'relay' bills through the VPS Claude relay
# and needs no API key; 'anthropic' needs ANTHROPIC_API_KEY.
AI_PROVIDER=relay
AI_RELAY_URL=
AI_RELAY_SECRET=
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=50

# Live classes. Without a JaaS tenant the client falls back to public meet.jit.si,
# where nobody can start a meeting — learners sit at "waiting for moderator".
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=

# Credential anchoring. 'simulated' does NOT write to a chain.
BLOCKCHAIN_CHAIN=simulated

HCAPTCHA_SECRET=

# ── Who this deployment says it is when it issues something ──────────────────
# The copied code hardcoded TalentLedger's identity in a dozen places; it now
# reads from here. Leave these unset and they are derived from CLIENT_URL:
#   PUBLIC_BASE = https://nsp.ppmc.pk/lms
#   ISSUER_DID  = did:web:nsp.ppmc.pk:lms
# A did:web identifier only resolves once the matching DID document is served
# at <PUBLIC_BASE>/.well-known/did.json — until then a credential issued here
# carries a correct name that a verifier cannot look up.
# PUBLIC_BASE=https://nsp.ppmc.pk/lms
# ISSUER_DID=did:web:nsp.ppmc.pk:lms
ISSUER_NAME=NSP Learning
